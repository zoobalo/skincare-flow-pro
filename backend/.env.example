# Copy to .env and fill in your values
# Local PostgreSQL (default port 5432)
DATABASE_URL=postgresql://postgres:password@localhost:5432/skinops

# ---------------------------------------------------------------------------
# Browsing PRODUCTION data from a laptop
# ---------------------------------------------------------------------------
# Production PostgreSQL runs on the EC2 box and its 5432 is closed to the
# internet, so it is reached through an SSH tunnel:
#
#   npm run db:tunnel        # 127.0.0.1:5433 -> ec2 localhost:5432
#   npm run db:studio:prod   # Drizzle Studio, read-only
#   npm run db:tunnel:stop
#
# Put the line below in backend/.env.local (gitignored — it holds a password).
# The zoobalo_ro role has SELECT only; PostgreSQL refuses any write through it.
# DATABASE_URL_RO=postgresql://zoobalo_ro:[password]@127.0.0.1:5433/zoobalo
#
# Schema changes are applied ON the EC2 box, never through the tunnel:
#   cd ~/skincare-flow-pro/backend && npm run db:push
